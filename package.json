{
  "name": "codex-local",
  "displayName": "Codex Local",
  "description": "A local AI coding assistant running inside the VS Code sidebar.",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onView:codexLocal.chatView"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "codexLocalSidebar",
          "title": "Codex Local",
          "icon": "$(sparkle)"
        }
      ]
    },
    "views": {
      "codexLocalSidebar": [
        {
          "id": "codexLocal.chatView",
          "type": "webview",
          "name": "Codex Local"
        }
      ]
    },
    "commands": [
      {
        "command": "codexLocal.openChat",
        "title": "Codex Local: Open Chat"
      },
      {
        "command": "codexLocal.explainCode",
        "title": "Codex Local: Explain Code"
      },
      {
        "command": "codexLocal.fixCode",
        "title": "Codex Local: Fix Code"
      },
      {
        "command": "codexLocal.clearHistory",
        "title": "Codex Local: Clear History"
      },
      {
        "command": "codexLocal.analyzeProject",
        "title": "Codex Local: Analyze Project"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "codexLocal.explainCode",
          "when": "editorHasSelection",
          "group": "codexLocal@1"
        },
        {
          "command": "codexLocal.fixCode",
          "when": "editorHasSelection",
          "group": "codexLocal@2"
        }
      ]
    },
    "configuration": {
      "title": "Codex Local",
      "properties": {
        "codexLocal.ollamaHost": {
          "type": "string",
          "default": "http://localhost:11434",
          "description": "URL where Ollama is running. Default: http://localhost:11434. Change this only if you are running Ollama on a different port or a remote machine."
        },
        "codexLocal.model": {
          "type": "string",
          "default": "gemma4:e2b",
          "description": "Ollama model name to use. Default: gemma4:e2b. Must match exactly what you see in: ollama list"
        },
        "codexLocal.maxHistoryMessages": {
          "type": "number",
          "default": 50,
          "minimum": 5,
          "maximum": 200,
          "description": "Number of past messages included in each request for conversation context. Default: 50. Lower this if responses are slow."
        },
        "codexLocal.contextLines": {
          "type": "number",
          "default": 200,
          "minimum": 10,
          "maximum": 1000,
          "description": "Maximum lines of the active file included as context in each request. Default: 200. Lower this for large files."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "check-types": "tsc --noEmit"
  },
  "dependencies": {
    "ollama": "^0.5.17",
    "sql.js": "^1.14.1"
  },
  "devDependencies": {
    "@types/node": "^22.19.19",
    "@types/sql.js": "^1.4.11",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.9.3"
  }
}
