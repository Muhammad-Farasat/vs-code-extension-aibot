{
  "name": "fax-ai",
  "displayName": "fax-ai",
  "publisher": "fax-ai",
  "description": "A professional AI coding assistant with sidebar chat and code writing capabilities.",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCommand:ai.explainCode",
    "onCommand:ai.fixCode",
    "onCommand:ai.addComments",
    "onCommand:ai.genTests",
    "onCommand:ai.listModels",
    "onView:faxAi.chatView"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "fax-ai-sidebar",
          "title": "fax-ai",
          "name": "fax-ai",
          "icon": "$(sparkle)"
        }
      ]
    },
    "views": {
      "fax-ai-sidebar": [
        {
          "id": "faxAi.chatView",
          "type": "webview",
          "name": "fax-ai Chat",
          "title": "fax-ai Chat"
        }
      ]
    },
    "commands": [
      {
        "command": "ai.explainCode",
        "title": "fax-ai: Explain Code"
      },
      {
        "command": "ai.fixCode",
        "title": "fax-ai: Fix Code"
      },
      {
        "command": "ai.addComments",
        "title": "fax-ai: Add Comments"
      },
      {
        "command": "ai.genTests",
        "title": "fax-ai: Generate Tests"
      },
      {
        "command": "ai.listModels",
        "title": "fax-ai: List Models"
      },
      {
        "command": "ai.applyCode",
        "title": "fax-ai: Apply to Editor"
      },
      {
        "command": "ai.editCode",
        "title": "fax-ai: Edit with AI"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "ai.editCode",
          "group": "navigation",
          "when": "editorHasSelection"
        },
        {
          "command": "ai.explainCode",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "fax-ai",
      "properties": {
        "faxAi.endpoint": {
          "type": "string",
          "default": "http://localhost:11434",
          "description": "Base URL of your local AI server. Ollama: http://localhost:11434 | Open WebUI: http://localhost:3000 | LM Studio: http://localhost:1234"
        },
        "faxAi.model": {
          "type": "string",
          "default": "gemma:4b",
          "description": "Model name to use for completions."
        },
        "faxAi.apiKey": {
          "type": "string",
          "default": "",
          "description": "API key / Bearer token (leave empty if your server doesn't require one)."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "@types/vscode": "^1.100.0",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "esbuild": "^0.27.3",
    "eslint": "^9.39.3",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1"
  }
}